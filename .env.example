# ── 중앙 서버 (EUM Control Server) ──
# PostgreSQL 접속 주소
DATABASE_URL=postgres://eum:비밀번호@localhost:5432/eum
# 로그인 토큰 서명용 비밀키 (16자 이상의 무작위 문자열).  생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 서버 포트
PORT=4000
# 결과물(ZIP) 저장 폴더
STORAGE_DIR=./data/storage
# 첫 사용자(관리자) 이후의 회원가입 허용 여부 (1=허용, 기본은 닫힘)
ALLOW_SIGNUP=0
# 작업 임대 시간(초). PC 엔진 응답이 이 시간 동안 없으면 작업을 회수합니다.
LEASE_SEC=60
# 결과물 최대 크기(MB)
MAX_ARTIFACT_MB=500
# 리버스 프록시 단계 수 (Railway·Nginx 뒤에 있으면 1)
TRUST_PROXY=1
# DB 가 SSL 을 요구하면 1
PGSSL=0

# ── docker compose 전용 ──
POSTGRES_PASSWORD=
HTTP_PORT=4000
